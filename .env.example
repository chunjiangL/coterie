DISCORD_TOKEN=your_discord_bot_token_here
# LLM backend: 'anthropic' (default, Claude Opus 4.7 + Sonnet 4.6 + Haiku 4.5)
# or 'openai' (GPT-5.5 Pro + GPT-5.5 + GPT-4o-mini). Both routes share the
# same Mem0 vector store, so you can swap at runtime to compare.
BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ─── Feature toggles ────────────────────────────────────────────────
# Build + auto-refresh per-user profiles from message history. When ON,
# @ replies load the asker's profile into the system header and proactive
# classifier reads the user's "Bot 互动偏好" line. true|false (default true).
PROFILES_ENABLED=true
# Sliding-window LLM-generated English annotations of messages, stored as
# extra Mem0 records to improve semantic retrieval. Off → no annotation
# LLM calls (cheaper) but search recall drops ~half the lift.
# true|false (default true).
ANNOTATOR_ENABLED=true

# ─── Digest channels ────────────────────────────────────────────────
# Comma-separated channel IDs (right-click a Discord channel with Developer
# Mode on → "Copy Channel ID").
#
# DAILY_DIGEST_CHANNELS — channels that get a 9am-LA daily summary.
# WEEKLY_DIGEST_CHANNELS — channels that get a Monday-9am-LA weekly summary.
# Leave both empty to disable digests entirely.
#
# Backward-compat: if these two are unset, both fall back to DIGEST_CHANNELS.
DAILY_DIGEST_CHANNELS=
WEEKLY_DIGEST_CHANNELS=
DIGEST_CHANNELS=

# ─── Proactive participation ────────────────────────────────────────
# Channels where the bot may chime in WITHOUT being @-ed. Each non-@ msg is
# classified; fire-rate bounded by 8s debounce + 60s cooldown (same-speaker
# follow-ups bypass cooldown). Comma-separated. Empty = disabled.
PROACTIVE_CHANNELS=
# Whole servers (guild IDs) where proactive is on for EVERY text channel.
# Convenient so new channels auto-inherit. PROACTIVE_CHANNELS works as an
# additional override across servers. Comma-separated.
PROACTIVE_SERVERS=
