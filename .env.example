DISCORD_TOKEN=your_discord_bot_token_here
# LLM backend: 'anthropic' (default, Claude Opus 4.7 + Sonnet 4.6 + Haiku 4.5)
# or 'openai' (GPT-5.5 Pro + GPT-5.5 + GPT-4o-mini). Both routes share the
# same Mem0 vector store, so you can swap at runtime to compare.
BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Comma-separated channel IDs that get a daily 9am LA digest + weekly
# (Mondays) digest. Leave empty to disable. Find the ID by right-clicking
# a channel in Discord with Developer Mode on → "Copy Channel ID".
DIGEST_CHANNELS=
# Channels where the bot proactively jumps into research discussions
# (without being @-ed). Each non-@ message is classified by Opus 4.7;
# fire-rate is bounded by 8s debounce + 5min per-channel cooldown.
# Comma-separated. Empty = disabled.
PROACTIVE_CHANNELS=
# Whole servers (guild IDs) where the bot proactively participates in
# every text channel. Useful so new channels added later automatically
# get the bot — no need to maintain a channel list. Comma-separated.
# Set this if you want "the bot is part of all research-group channels"
# behavior. PROACTIVE_CHANNELS still works as an additional override.
PROACTIVE_SERVERS=
