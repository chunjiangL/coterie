# ─── Chat platform ──────────────────────────────────────────────────
# Which chat platform this bot runs on. Drives markdown formatting rules
# baked into agent prompts. Defaults to 'discord' (run via `python bot.py`).
# Set to 'slack' and run `python slack_bot.py` instead.
PLATFORM=discord

# ─── Platform credentials ───────────────────────────────────────────
# Discord: get from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Slack: get from https://api.slack.com/apps
#  - SLACK_BOT_TOKEN: "Bot User OAuth Token" (xoxb-...) under OAuth & Permissions
#  - SLACK_APP_TOKEN: "App-Level Token" (xapp-...) with `connections:write` scope
#    under Basic Information. Required for Socket Mode.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ─── LLM backend ────────────────────────────────────────────────────
# 'anthropic' (default, Claude Opus 4.7 + Sonnet 4.6 + Haiku 4.5)
# or 'openai' (GPT-5.5 Pro + GPT-5.5 + GPT-4o-mini). Both routes share the
# same Mem0 vector store, so you can swap at runtime to compare.
BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ─── Community identity ─────────────────────────────────────────────
# Free-text describing what this community talks about. Replaces the
# formerly hard-coded "research" vocabulary in prompts so the same bot
# can run a frontend-dev guild, DAO governance group, design crit channel,
# etc. Sensible defaults preserve original ML-research behavior.
COMMUNITY_NAME=the channel
COMMUNITY_DOMAIN=research
# Comma-prose listing what counts as substantive content (vs chitchat).
SUBSTANTIVE_TOPICS=model architecture, training, papers, datasets, infrastructure, RL/RLHF, agent design, code, hardware
# URL domain types that count as content-bearing (not memes / random news).
RELEVANT_LINK_DOMAINS=arxiv abstract/pdf, GitHub repos about ML / agents / research code, X.com posts about a paper or project, huggingface model cards, anthropic / openai / deepmind / thinkingmachines blog posts

# ─── Feature toggles ────────────────────────────────────────────────
# Build + auto-refresh per-user profiles from message history. When ON,
# @ replies load the asker's profile into the system header and proactive
# classifier reads the user's "Bot 互动偏好" line. true|false (default true).
PROFILES_ENABLED=true
# Sliding-window LLM-generated English annotations of messages, stored as
# extra Mem0 records to improve semantic retrieval. Off → no annotation
# LLM calls (cheaper) but search recall drops ~half the lift.
# true|false (default true).
ANNOTATOR_ENABLED=true

# ─── Digest channels ────────────────────────────────────────────────
# Comma-separated channel IDs (right-click a Discord channel with Developer
# Mode on → "Copy Channel ID").
#
# DAILY_DIGEST_CHANNELS — channels that get a 9am-LA daily summary.
# WEEKLY_DIGEST_CHANNELS — channels that get a Monday-9am-LA weekly summary.
# Leave both empty to disable digests entirely.
#
# Backward-compat: if these two are unset, both fall back to DIGEST_CHANNELS.
DAILY_DIGEST_CHANNELS=
WEEKLY_DIGEST_CHANNELS=
DIGEST_CHANNELS=

# ─── Proactive participation ────────────────────────────────────────
# Channels where the bot may chime in WITHOUT being @-ed. Each non-@ msg is
# classified; fire-rate bounded by 8s debounce + 60s cooldown (same-speaker
# follow-ups bypass cooldown). Comma-separated. Empty = disabled.
PROACTIVE_CHANNELS=
# Whole servers (guild IDs) where proactive is on for EVERY text channel.
# Convenient so new channels auto-inherit. PROACTIVE_CHANNELS works as an
# additional override across servers. Comma-separated.
PROACTIVE_SERVERS=

# ─── Cross-channel context ──────────────────────────────────────────
# Channels listed here have their channel_profile treated as "public
# knowledge" — every reply in every channel reads their summary alongside
# its own. Private channels never appear here and never leak across.
# Only the synthesized profile blurb crosses; raw messages never do.
# Empty (default) = no cross-channel sharing at all.
PUBLIC_CHANNELS=
